{
  "version": 3,
  "buildPresets": [
    { "name": "clang", "configurePreset": "clang" },
    { "name": "gcc", "configurePreset": "gcc" }
  ],
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "clang",
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang" }
    },
    {
      "name": "gcc",
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc" }
    }
  ]
}
